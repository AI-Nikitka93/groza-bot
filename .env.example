# ==========================================
# GROZA - PERSONAL LIGHTNING ROD (Zero-Cost)
# Environment Variables Template
# ==========================================

# 1. TELEGRAM BOT
# Обязательно: Получите токен у @BotFather
TELEGRAM_BOT_TOKEN="1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# 2. TEMBO POSTGRES (PostGIS)
# Обязательно: Строка подключения из Tembo Cloud
DATABASE_URL="postgres://postgres:password@host-name.tembo.io:5432/postgres"

# 3. UPSTASH REDIS
# Обязательно: Данные из консоли Upstash для REST/ioredis
UPSTASH_REDIS_REST_URL="https://upstash-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_rest_token_here"
REDIS_URL="rediss://default:password@upstash-url.upstash.io:6379"

# 4. IMGUR API
# Обязательно: Client ID для анонимной загрузки сгенерированных карт
# Регистрация: https://api.imgur.com/oauth2/addclient
IMGUR_CLIENT_ID="your_client_id_here"

# 5. THREADS GRAPH API
# Обязательно: User ID и Long-Lived Access Token (60 дней) 
# Токен необходимо рефрешить раз в месяц через cron
THREADS_USER_ID="123456789012345"
THREADS_ACCESS_TOKEN="EAAXXXXXXX_long_lived_token_here"

# 6. PORT (Express Server)
PORT=3000
